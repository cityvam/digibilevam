# کپی به /etc/digitalpay/web.env (chmod 640، مالک root:dpweb). هرگز داخل git نگذارید.
PORT=3000
HOSTNAME=127.0.0.1
API_URL=http://127.0.0.1:5200
# Host اصلی سایت برای تشخیص مستأجر در API
API_HOST_HEADER=ghestine.ir
# دامنه‌های مجاز Server Actions (پشت nginx) — فقط host، با ویرگول. در زمان build خوانده می‌شود (next.config.mjs)
SITE_ORIGINS=ghestine.ir,www.ghestine.ir
COOKIE_SECURE=true
